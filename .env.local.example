# Schema setup (non-production only): GET /api/setup?token=...
SETUP_TOKEN=your_setup_token_here

# Admin panel login and session signing
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET=your_admin_secret_here

# Neon PostgreSQL — get from console.neon.tech → Connection Details
# Format: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo

# AI Provider (openai | mock) — defaults to mock if unset
AI_PROVIDER=mock
